{
  "manifest_version": 3,
  "name": "OnShape Redactor",
  "version": "1.0",
  "description": "Decodes base64 document-list filenames on OnShape when the URL ends in =resourceuserowner.",
  "permissions": ["activeTab", "webRequest"],
  "host_permissions": ["*://cad.onshape.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OnShape Redactor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.onshape.com/*"],
      "js": ["decoder.js", "encoder.js", "main.js"],
      "run_at": "document_idle"
    }
  ]
}